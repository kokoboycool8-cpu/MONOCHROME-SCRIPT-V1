    local digits =
        printed and printed:FindFirstChild("Digits")

    if digits and digits:IsA("TextLabel") then
        codeLabel.Text =
            "Code: " .. digits.Text

    elseif digits and digits:IsA("TextButton") then
        codeLabel.Text =
