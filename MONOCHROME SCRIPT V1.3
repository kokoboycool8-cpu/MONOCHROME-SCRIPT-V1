--// Key Buttons
local keyButtons = {}

local function createKeyButton(keyNumber, yPosition)

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 180, 0, 35)
    button.Position = UDim2.new(0.5, -90, 0, yPosition)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 16
    button.Font = Enum.Font.SourceSansBold
    button.Text = "Collect Key " .. keyNumber
    button.BorderSizePixel = 0
    button.Parent = main

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 6)
    buttonCorner.Parent = button

    keyButtons[keyNumber] = button

    button.MouseButton1Click:Connect(function()

        local monochrome = workspace:FindFirstChild("monochrome")
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not monochrome or not root then
            button.Text = "Unable to Collect"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        local key = monochrome:FindFirstChild("HiddenKey" .. keyNumber)
        local keyFolder = key and key:FindFirstChild("Key")
        local promptPoint = keyFolder and keyFolder:FindFirstChild("KeyPromptPoint")
        local prompt = promptPoint and promptPoint:FindFirstChild("KeyPrompt")

        if not key or not prompt or not prompt:IsA("ProximityPrompt") then
            button.Text = "Key Not Found"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        local keyPart

        if key:IsA("BasePart") then
            keyPart = key
        elseif key:IsA("Model") then
            keyPart = key.PrimaryPart
                or key:FindFirstChildWhichIsA("BasePart", true)
        end

        if not keyPart then
            button.Text = "Key Position Missing"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        local originalCFrame = root.CFrame

        button.Text = "Collecting..."

        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 5000

        root.CFrame = keyPart.CFrame + Vector3.new(0, 3, 0)

        task.wait(0.15)

        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end

        task.wait(0.15)

        if root and root.Parent then
            root.CFrame = originalCFrame
        end

        button.Text = "Key " .. keyNumber .. " Collected"

        task.delay(1.5, function()
            if button.Parent then
                button.Text = "Collect Key " .. keyNumber
            end
        end)
    end)

    return button
end

createKeyButton(1, 210)
createKeyButton(2, 250)
createKeyButton(3, 290)
createKeyButton(4, 330)

--// PC + Mobile Draggable UI
local dragging = false
local dragStart
local startPosition

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

--// Create Map ESP Label
local function createLabel(target, text)
    local adorneePart = target

    if target:IsA("Model") then
        adorneePart = target:FindFirstChildWhichIsA("BasePart", true)
    end

    if not adorneePart then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Label"
    billboard.Adornee = adorneePart
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextSize = 16
    label.Font = Enum.Font.SourceSansBold
    label.Text = text
    label.Parent = billboard

    table.insert(labels, billboard)

    return billboard
end

--// Clear Map ESP
local function clearESP()
    for _, highlight in ipairs(highlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    for _, label in ipairs(labels) do
        if label and label.Parent then
            label:Destroy()
        end
    end

    highlights = {}
    labels = {}
end

--// Enable Map ESP
local function enableESP()
    clearESP()

    local monochrome = workspace:FindFirstChild("monochrome")

    if monochrome then
        for i = 1, 4 do
            local key = monochrome:FindFirstChild("HiddenKey" .. i)

            if key then
                local highlight = Instance.new("Highlight")
                highlight.Name = "HiddenKeyESP"
                highlight.Adornee = key

                --// BLUE KEY ESP + BLACK OUTLINE
                highlight.FillColor = Color3.fromRGB(0, 140, 255)
                highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                highlight.FillTransparency = 0
                highlight.OutlineTransparency = 0

                highlight.Parent = key

                table.insert(highlights, highlight)

                createLabel(key, "Key " .. i)
            end
        end
    end

    --// RED MONOCHROME / VER ESP
    local ver = workspace:FindFirstChild("VER")

    if ver then
        local highlight = Instance.new("Highlight")
        highlight.Name = "VER_ESP"
        highlight.Adornee = ver

        --// RED ENTITY ESP + BLACK OUTLINE
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
        highlight.FillTransparency = 0
        highlight.OutlineTransparency = 0

        highlight.Parent = ver

        table.insert(highlights, highlight)

        createLabel(ver, "MONOCHROME")
    end
end

--// Clear Player ESP
local function clearPlayerESP()
    for _, highlight in ipairs(playerHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    for _, billboard in ipairs(playerLabels) do
        if billboard and billboard.Parent then
            billboard:Destroy()
        end
    end

    playerHighlights = {}
    playerLabels = {}
end

--// Create Player ESP
local function createPlayerESP(targetPlayer)
    if targetPlayer == player then
        return
    end

    local character = targetPlayer.Character

    if not character then
        return
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not rootPart then
        return
    end

    --// WHITE PLAYER ESP + BLACK OUTLINE
    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerESP"
    highlight.Adornee = character

    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
    highlight.FillTransparency = 0
    highlight.OutlineTransparency = 0

    highlight.Parent = character

    table.insert(playerHighlights, highlight)

    --// Player Label
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlayerESP_Label"
    billboard.Adornee = rootPart
    billboard.Size = UDim2.new(0, 180, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextSize = 16
    label.Font = Enum.Font.SourceSansBold
    label.Text = targetPlayer.Name .. "\n0 studs"
    label.Parent = billboard

    table.insert(playerLabels, billboard)
end

--// Enable Player ESP
local function enablePlayerESP()
    clearPlayerESP()

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        createPlayerESP(targetPlayer)
    end
end

--// Player Added
Players.PlayerAdded:Connect(function(targetPlayer)
    targetPlayer.CharacterAdded:Connect(function()
        if playerESPEnabled then
            task.wait(1)
            createPlayerESP(targetPlayer)
        end
    end)
end)

--// Update Distances
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    --// Map ESP distances
    if espEnabled then
        for _, billboard in ipairs(labels) do
            if billboard
                and billboard.Parent
                and billboard.Adornee then

                local target = billboard.Adornee
                local distance =
                    (root.Position - target.Position).Magnitude

                local label =
                    billboard:FindFirstChildOfClass("TextLabel")

                if label then
                    local name =
                        label.Text:match("^[^\n]+")

                    label.Text =
                        name .. "\n"
                        .. math.floor(distance)
                        .. " studs"
                end
            end
        end
    end

    --// Player ESP distances
    if playerESPEnabled then
        for _, billboard in ipairs(playerLabels) do
            if billboard
                and billboard.Parent
                and billboard.Adornee then

                local targetRoot = billboard.Adornee
                local targetCharacter = targetRoot.Parent
                local targetPlayer =
                    Players:GetPlayerFromCharacter(targetCharacter)

                if targetPlayer then
                    local distance =
                        (root.Position - targetRoot.Position).Magnitude

                    local label =
                        billboard:FindFirstChildOfClass("TextLabel")

                    if label then
                        label.Text =
                            targetPlayer.Name
                            .. "\n"
                            .. math.floor(distance)
                            .. " studs"
                    end
                end
            end
        end
    end
end)

