--// Enable/Disable Enter Code
local function setEnterCodeEnabled(enabled)
    enterCodeButton.Active = enabled
    enterCodeButton.AutoButtonColor = enabled

    if enabled then
        enterCodeButton.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        enterCodeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        enterCodeButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        enterCodeButton.TextColor3 = Color3.fromRGB(120, 120, 120)
    end
end

