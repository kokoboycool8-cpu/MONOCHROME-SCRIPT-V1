--// Update Distances
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    --// Map ESP distances
    if espEnabled then
        for _, billboard in ipairs(labels) do
            if billboard
                and billboard.Parent
                and billboard.Adornee then

                local target = billboard.Adornee
                local distance =
                    (root.Position - target.Position).Magnitude

                local label =
                    billboard:FindFirstChildOfClass("TextLabel")

                if label then
                    local name =
                        label.Text:match("^[^\n]+")

                    label.Text =
                        name .. "\n"
                        .. math.floor(distance)
                        .. " studs"
                end
            end
        end
    end

    --// Player ESP distances
    if playerESPEnabled then
        for _, billboard in ipairs(playerLabels) do
            if billboard
                and billboard.Parent
                and billboard.Adornee then

                local targetRoot = billboard.Adornee
                local targetCharacter = targetRoot.Parent
                local targetPlayer =
                    Players:GetPlayerFromCharacter(targetCharacter)

                if targetPlayer then
                    local distance =
                        (root.Position - targetRoot.Position).Magnitude

                    local label =
                        billboard:FindFirstChildOfClass("TextLabel")

                    if label then
                        label.Text =
                            targetPlayer.Name
                            .. "\n"
                            .. math.floor(distance)
                            .. " studs"
                    end
                end
            end
        end
    end
end)

--// Refresh Code
refreshButton.MouseButton1Click:Connect(function()
    local monochrome = workspace:FindFirstChild("monochrome")
    local codeNote = monochrome and monochrome:FindFirstChild("CodeNote")
    local printed = codeNote and codeNote:FindFirstChild("Printed")
    local digits = printed and printed:FindFirstChild("Digits")

    currentCode = nil

    setEnterCodeEnabled(false)
    setCompleteEnabled(false)

    if digits and (digits:IsA("TextLabel") or digits:IsA("TextButton")) then
        local code = tostring(digits.Text)

        --// Keep only numbers
        code = code:gsub("%D", "")

        if #code == 4 then
            currentCode = code
            codeLabel.Text = "Code: " .. code

            setEnterCodeEnabled(true)
            setCompleteEnabled(true)
        else
            codeLabel.Text = "Code: Invalid"
        end
    else
        codeLabel.Text = "Code: Not Found"
    end
end)

--// Enter Code
enterCodeButton.MouseButton1Click:Connect(function()
    if not currentCode or enteringCode or completingSequence then
        return
    end

    local monochrome = workspace:FindFirstChild("monochrome")
    local keypad = monochrome and monochrome:FindFirstChild("Keypad")

    if not keypad then
        enterCodeButton.Text = "Keypad Not Found"
        return
    end

    enteringCode = true
    setEnterCodeEnabled(false)

    enterCodeButton.Text = "Entering..."

    local success = true

    for i = 1, 4 do

        local wantedDigit = currentCode:sub(i, i)

        local digitObject =
            keypad:FindFirstChild("Digit" .. i)

        local clickDetector =
            digitObject and digitObject:FindFirstChild("ClickDetector")

        local readout =
            digitObject and digitObject:FindFirstChild("Readout")

        local digitText =
            readout and readout:FindFirstChild("Digit")

        if not digitObject
            or not clickDetector
            or not clickDetector:IsA("ClickDetector")
            or not digitText then

            success = false
            break
        end

        local attempts = 0
        local maxAttempts = 20

        while tostring(digitText.Text) ~= wantedDigit
            and attempts < maxAttempts do

            attempts += 1

            if fireclickdetector then
                fireclickdetector(clickDetector)
            else
                success = false
                break
            end

            task.wait(0.1)
        end

        if not success then
            break
        end

        if tostring(digitText.Text) ~= wantedDigit then
            success = false
            break
        end

        task.wait(0.1)
    end

    if success then
        enterCodeButton.Text = "Code Entered"
    else
        enterCodeButton.Text = "Failed"
    end

    enteringCode = false

    task.delay(1.5, function()
        if enterCodeButton.Parent then
            enterCodeButton.Text = "Enter Code"

            if currentCode and not completingSequence then
                setEnterCodeEnabled(true)
            end
        end
    end)
end)

--// Fire Lock Prompt
local function fireLockPrompt(cubeName)
    local monochrome = workspace:FindFirstChild("monochrome")

    if not monochrome then
        return false
    end

    local cube = monochrome:FindFirstChild(cubeName)

    local promptPoint =
        cube and cube:FindFirstChild("LockPromptPoint")

    local prompt =
        promptPoint and promptPoint:FindFirstChild("LockPrompt")

    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end

    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 5000

    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end

    task.wait(0.2)

    return true
end

--// Complete Sequence
completeButton.MouseButton1Click:Connect(function()

    if not currentCode
        or enteringCode
        or completingSequence then
        return
    end

    local monochrome = workspace:FindFirstChild("monochrome")

    if not monochrome then
        completeButton.Text = "Map Not Found"
        return
    end

    completingSequence = true

    setCompleteEnabled(false)
    setEnterCodeEnabled(false)

    --// Refresh code
    completeButton.Text = "Checking Code..."

    local codeNote =
        monochrome:FindFirstChild("CodeNote")

    local printed =
        codeNote and codeNote:FindFirstChild("Printed")

    local digits =
        printed and printed:FindFirstChild("Digits")

    if not digits
        or not (digits:IsA("TextLabel") or digits:IsA("TextButton")) then

        completeButton.Text = "Code Not Found"
        completingSequence = false
        return
    end

    local code =
        tostring(digits.Text):gsub("%D", "")

    if #code ~= 4 then
        completeButton.Text = "Invalid Code"
        completingSequence = false
        return
    end

    currentCode = code
    codeLabel.Text = "Code: " .. code

    --// Enter Code
    completeButton.Text = "Entering Code..."

    local keypad =
        monochrome:FindFirstChild("Keypad")

    if not keypad then
        completeButton.Text = "Keypad Not Found"
        completingSequence = false
        return
    end

    local codeSuccess = true

    for i = 1, 4 do

        local wantedDigit =
            currentCode:sub(i, i)

        local digitObject =
            keypad:FindFirstChild("Digit" .. i)

        local clickDetector =
            digitObject and digitObject:FindFirstChild("ClickDetector")

        local readout =
            digitObject and digitObject:FindFirstChild("Readout")

        local digitText =
            readout and readout:FindFirstChild("Digit")

        if not clickDetector
            or not digitText then

            codeSuccess = false
            break
        end

        local attempts = 0
        local maxAttempts = 20

        while tostring(digitText.Text) ~= wantedDigit
            and attempts < maxAttempts do

            attempts += 1

            if fireclickdetector then
                fireclickdetector(clickDetector)
            else
                codeSuccess = false
                break
            end

            task.wait(0.1)
        end

        if not codeSuccess then
            break
        end

        if tostring(digitText.Text) ~= wantedDigit then
            codeSuccess = false
            break
        end

        task.wait(0.1)
    end

    if not codeSuccess then
        completeButton.Text = "Code Failed"
        completingSequence = false

        task.delay(1.5, function()
            if completeButton.Parent and currentCode then
                setCompleteEnabled(true)
                setEnterCodeEnabled(true)
                completeButton.Text = "Complete Sequence"
            end
        end)

        return
    end

    --// Collect Keys
    completeButton.Text = "Collecting Keys..."

    local character = player.Character
    local root =
        character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        completeButton.Text = "Character Not Found"
        completingSequence = false
        return
    end

    for i = 1, 4 do

        local key =
            monochrome:FindFirstChild("HiddenKey" .. i)

        local keyFolder =
            key and key:FindFirstChild("Key")

        local promptPoint =
            keyFolder and keyFolder:FindFirstChild("KeyPromptPoint")

        local prompt =
            promptPoint and promptPoint:FindFirstChild("KeyPrompt")

        if not key
            or not prompt
            or not prompt:IsA("ProximityPrompt") then

            completeButton.Text =
                "Key " .. i .. " Not Found"

            completingSequence = false
            return
        end

        local keyPart

        if key:IsA("BasePart") then
            keyPart = key
        elseif key:IsA("Model") then
            keyPart =
                key.PrimaryPart
                or key:FindFirstChildWhichIsA("BasePart", true)
        end

        if not keyPart then
            completeButton.Text =
                "Key " .. i .. " Position Error"

            completingSequence = false
            return
        end

        local originalCFrame = root.CFrame

        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 5000

        root.CFrame =
            keyPart.CFrame + Vector3.new(0, 3, 0)

        task.wait(0.15)

        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end

        task.wait(0.15)

        if root and root.Parent then
            root.CFrame = originalCFrame
        end

        task.wait(0.2)
    end

    --// Unlock the four locks
    completeButton.Text = "Unlocking..."

    local cubes = {
        "Cube.028",
        "Cube.035",
        "Cube.031",
        "Cube.033"
    }

    for _, cubeName in ipairs(cubes) do

        local success =
            fireLockPrompt(cubeName)

        if not success then
            completeButton.Text =
                cubeName .. " Failed"

            completingSequence = false
            return
        end

        task.wait(0.2)
    end

    --// Elevator
    completeButton.Text = "Calling Elevator..."

    local cylinder =
        monochrome:FindFirstChild("Cylinder.002")

    local elevatorPoint =
        cylinder and cylinder:FindFirstChild("ElevatorPromptPoint")

    local elevatorPrompt =
        elevatorPoint and elevatorPoint:FindFirstChild("ElevatorPrompt")

    if not elevatorPrompt
        or not elevatorPrompt:IsA("ProximityPrompt") then

        completeButton.Text = "Elevator Not Found"
        completingSequence = false
        return
    end

    elevatorPrompt.RequiresLineOfSight = false
    elevatorPrompt.MaxActivationDistance = 5000

    if fireproximityprompt then
        fireproximityprompt(elevatorPrompt)
    else
        elevatorPrompt:InputHoldBegin()
        task.wait(elevatorPrompt.HoldDuration)
        elevatorPrompt:InputHoldEnd()
    end

    completeButton.Text = "Complete!"

    completingSequence = false

    task.delay(2, function()
        if completeButton.Parent then
            completeButton.Text = "Complete Sequence"

            if currentCode then
                setCompleteEnabled(true)
                setEnterCodeEnabled(true)
            end
        end
    end)
end)

