--// Draggable UI - PC + Mobile
local dragging = false
local dragStart
local startPosition

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

--// Create ESP Label
local function createLabel(target, text)
    local adorneePart = target

    if target:IsA("Model") then
        adorneePart = target:FindFirstChildWhichIsA("BasePart", true)
    end

    if not adorneePart then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Label"
    billboard.Adornee = adorneePart
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = gui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextSize = 16
    label.Font = Enum.Font.SourceSansBold
    label.Text = text
    label.Parent = billboard

    table.insert(labels, billboard)

    return billboard
end

--// Clear ESP
local function clearESP()
    for _, highlight in ipairs(highlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    for _, label in ipairs(labels) do
        if label and label.Parent then
            label:Destroy()
        end
    end

    highlights = {}
    labels = {}
end

--// Enable ESP
local function enableESP()
    clearESP()

    local monochrome = workspace:FindFirstChild("monochrome")

    if monochrome then
        for i = 1, 4 do
            local key = monochrome:FindFirstChild("HiddenKey" .. i)

            if key then
                local highlight = Instance.new("Highlight")
                highlight.Name = "HiddenKeyESP"
                highlight.Adornee = key
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Parent = key

                table.insert(highlights, highlight)

                createLabel(key, "Key " .. i)
            end
        end
    end

    --// VER
    local ver = workspace:FindFirstChild("VER")

    if ver then
        local highlight = Instance.new("Highlight")
        highlight.Name = "VER_ESP"
        highlight.Adornee = ver
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = ver

        table.insert(highlights, highlight)

        createLabel(ver, "MONOCHROME")
    end
end

--// Update Distances
RunService.RenderStepped:Connect(function()
    if not espEnabled then
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    for _, billboard in ipairs(labels) do
        if billboard and billboard.Parent and billboard.Adornee then
            local target = billboard.Adornee
            local distance = (root.Position - target.Position).Magnitude

            local label = billboard:FindFirstChildOfClass("TextLabel")

            if label then
                local name = label.Text:match("^[^\n]+")
                label.Text = name .. "\n" .. math.floor(distance) .. " studs"
            end
        end
    end
end)

--// Refresh Code
refreshButton.MouseButton1Click:Connect(function()
    local monochrome = workspace:FindFirstChild("monochrome")
    local codeNote = monochrome and monochrome:FindFirstChild("CodeNote")
    local printed = codeNote and codeNote:FindFirstChild("Printed")
    local digits = printed and printed:FindFirstChild("Digits")

    if digits and digits:IsA("TextLabel") then
        codeLabel.Text = "Code: " .. digits.Text
    elseif digits and digits:IsA("TextButton") then
        codeLabel.Text = "Code: " .. digits.Text
    else
        codeLabel.Text = "Code: Not Found"
    end
end)

--// ESP Toggle
espButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled

    if espEnabled then
        espButton.Text = "ESP: On"
        enableESP()
    else
        espButton.Text = "ESP: Off"
        clearESP()
    end
end)
