--// Key Buttons
local keyButtons = {}

local function createKeyButton(keyNumber, yPosition)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 180, 0, 35)
    button.Position = UDim2.new(0.5, -90, 0, yPosition)
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 16
    button.Font = Enum.Font.SourceSansBold
    button.Text = "Collect Key " .. keyNumber
    button.BorderSizePixel = 0
    button.Parent = main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button

    keyButtons[keyNumber] = button

    button.MouseButton1Click:Connect(function()
        local monochrome = workspace:FindFirstChild("monochrome")
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not monochrome or not root then
            button.Text = "Unable to Collect"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        local key = monochrome:FindFirstChild("HiddenKey" .. keyNumber)
        local keyFolder = key and key:FindFirstChild("Key")
        local promptPoint = keyFolder and keyFolder:FindFirstChild("KeyPromptPoint")
        local prompt = promptPoint and promptPoint:FindFirstChild("KeyPrompt")

        if not key or not prompt or not prompt:IsA("ProximityPrompt") then
            button.Text = "Key Not Found"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        local keyPart

        if key:IsA("BasePart") then
            keyPart = key
        elseif key:IsA("Model") then
            keyPart = key.PrimaryPart
                or key:FindFirstChildWhichIsA("BasePart", true)
        end

        if not keyPart then
            button.Text = "Key Position Missing"

            task.delay(1.5, function()
                if button.Parent then
                    button.Text = "Collect Key " .. keyNumber
                end
            end)

            return
        end

        --// Save original position
        local originalCFrame = root.CFrame

        button.Text = "Collecting..."

        --// Disable line-of-sight requirement
        prompt.RequiresLineOfSight = false

        --// Increase activation distance
        prompt.MaxActivationDistance = 5000

        --// Teleport to the key
        root.CFrame = keyPart.CFrame + Vector3.new(0, 3, 0)

        --// Allow teleport to register
        task.wait(0.15)

        --// Fire the prompt once
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration)
            prompt:InputHoldEnd()
        end

        --// Allow interaction to register
        task.wait(0.15)

        --// Return to original position
        if root and root.Parent then
            root.CFrame = originalCFrame
        end

        button.Text = "Key " .. keyNumber .. " Collected"

        task.delay(1.5, function()
            if button.Parent then
                button.Text = "Collect Key " .. keyNumber
            end
        end)
    end)

    return button
end

